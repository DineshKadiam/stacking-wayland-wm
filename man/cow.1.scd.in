|  *border.active.s*
:  Active border: south edge.
|  *border.active.e*
:  Active border: east edge.
|  *border.active.w*
:  Active border: west edge.
|  *border.active.nw*
:  Active border: north-west corner.
|  *border.active.ne*
:  Active border: north-east corner.
|  *border.active.sw*
