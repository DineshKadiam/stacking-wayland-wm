{
    "layer": "top",
    "position": "top",
    "height": 18,

    "modules-left": ["custom/cow-desks"],
    "modules-center": ["custom/cow-title"],
    "modules-right": ["cpu", "memory", "cpu#loadavg", "clock", "tray"],

    "cpu": {
        "format": "[CPU:{}]"
    },
    "memory": {
        "format": "[MEM:{used}]"
    },
    "cpu#loadavg": {
        "format": "[AVG:{load}]"
    },
    "custom/cow-desks": {
        "exec": "/home/n6tadam/.config/waybar/cow-desks.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },
    "custom/cow-title": {
        "exec": "/home/n6tadam/.config/waybar/cow-title.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "max-length": 80
    },
    "clock": {
        "format": "[{:%b %d %H:%M:%S}]",
        "tooltip-format": "{:%A, %B %d, %Y}",
        "interval": 1
    }
}
